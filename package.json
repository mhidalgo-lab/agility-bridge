{
  "name": "agility-bridge-monorepo",
  "private": true,
  "description": "Unofficial MCP server for Digital.ai Agility \u2014 monorepo root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc -p scripts && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . && node scripts/check-runtime-imports.ts && node scripts/check-spdx.ts && node scripts/check-workflows.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "lefthook": "2.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
