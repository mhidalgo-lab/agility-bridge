{
  "name": "@agility-bridge/http-app",
  "version": "0.0.0",
  "description": "Hono HTTP app: per-workspace MCP endpoints, admin API, OAuth routes",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "agilityBridge": {
    "runtime": "web"
  },
  "dependencies": {
    "@agility-bridge/auth": "workspace:*",
    "@agility-bridge/core": "workspace:*",
    "@agility-bridge/storage": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "tsdown": "0.23.1"
  }
}
