{
  "name": "@agility-bridge/core",
  "version": "0.0.0",
  "description": "Runtime-agnostic core: tools, Agility client, metadata, query compiler, output shaping",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node bench/schema-cache.ts"
  },
  "agilityBridge": {
    "runtime": "web"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsdown": "0.23.1"
  }
}
