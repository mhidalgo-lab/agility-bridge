{
  "name": "@agility-bridge/auth",
  "version": "0.0.0",
  "description": "Device tokens, permission resolver, identity providers and OAuth integration",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
