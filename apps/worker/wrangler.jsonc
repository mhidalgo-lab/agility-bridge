// agility-bridge on Cloudflare Workers (P3-01). No account or resource ids are committed: the setup script (P3-05)
// writes them to an ignored local config per environment. Secrets (AB_MASTER_KEY, AB_ADMIN_TOKEN) are Worker secrets,
// never `vars`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agility-bridge",
  "main": "src/index.ts",
  // No `nodejs_compat`: every package is web-standard (docs/adr/0004-typescript-runtime-agnostic-core.md).
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "send_metrics": false,
  // The workspace packages are bundled from their sources (no build of the packages first).
  "alias": {
    "@agility-bridge/auth": "../../packages/auth/src/index.ts",
    "@agility-bridge/core": "../../packages/core/src/index.ts",
    "@agility-bridge/http-app": "../../packages/http-app/src/index.ts",
    "@agility-bridge/storage": "../../packages/storage/src/index.ts"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "agility-bridge", "database_id": "local" }],
  // Backstops across isolates for the per-isolate rate limits (P3-04): per location, eventually consistent.
  // Housekeeping (P3-08): audit retention, expired kv entries, key rotation and revalidation, in bounded slices.
  "triggers": { "crons": ["*/15 * * * *"] },
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
}
