{
  "name": "agility-bridge",
  "version": "0.4.0",
  "mcpName": "io.github.mhidalgo-lab/agility-bridge",
  "description": "Unofficial MCP server for Digital.ai Agility: let AI agents work with every asset type using your own access token",
  "license": "Apache-2.0",
  "author": "Matias Hidalgo",
  "homepage": "https://github.com/mhidalgo-lab/agility-bridge#readme",
  "bugs": {
    "url": "https://github.com/mhidalgo-lab/agility-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhidalgo-lab/agility-bridge.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "agility-bridge": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agility",
    "digital.ai",
    "versionone",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "agilityBridge": {
    "runtime": "node"
  },
  "devDependencies": {
    "@agility-bridge/auth": "workspace:*",
    "@agility-bridge/core": "workspace:*",
    "@agility-bridge/http-app": "workspace:*",
    "@agility-bridge/storage": "workspace:*",
    "@agility-bridge/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "tsdown": "0.23.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/server": "2.3.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "saxes": "6.0.0",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
